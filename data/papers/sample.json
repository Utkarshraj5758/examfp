  "questions": [
    {
      "id": "q1",
      "template": "{{intro}} Rohan drives {{dist}} km in {{time}} hours.\n{{lead}} his average speed in {{unit}}. {{closing}}",
      "answer": "60 km/h",
      "marks": 3,
      "slots": [
        { "name": "intro", "variants": ["On the way to Nashik,", "While driving to Nashik,"] },
        { "name": "speed", "fills": ["dist", "time"],
          "difficulty_band": { "operation": "divide", "operand_digits": [3, 1], "exclude_trivial": true },
          "variants": [
            { "values": ["180", "3"] }, { "values": ["240", "4"] }, { "values": ["300", "5"] },
            { "values": ["360", "6"] }, { "values": ["420", "7"] }, { "values": ["480", "8"] },
            { "values": ["540", "9"] }
          ] },
        { "name": "unit", "kind": "unit_form", "variants": ["km/h", "kilometres per hour", "kmph"] },
        { "name": "lead", "variants": ["Calculate", "Work out"] },
        { "name": "closing", "variants": ["Show your working.", "Include your working."] }
      ]
    },
    {
